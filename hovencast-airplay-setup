#!/bin/bash
set -euo pipefail
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cast_env="${XDG_DATA_HOME:-$HOME/.local/share}/hovencast/chromecast-venv"
if [[ ! -x "$cast_env/bin/python" ]]; then
  python -m venv --system-site-packages "$cast_env"
fi
"$cast_env/bin/python" -m pip install 'pyatv==0.18.0'
"$cast_env/bin/python" "$root/scripts/install_airplay_native.py"
exec "$cast_env/bin/python" "$root/scripts/airplay_setup.py" "$@"

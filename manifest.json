{
  "schemaVersion": 1,
  "id": "hoven.cast",
  "name": "HovenCast",
  "version": "0.2.0",
  "author": "Sean Hovenkamp",
  "license": "MIT",
  "description": "Cast a dedicated Hyprland workspace or application window with audio to compatible Roku TVs.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "HovenCast",
    "description": "Use a Roku TV as a wireless Hyprland workspace.",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "keepLocalAudio": false
    },
    "schema": [
      {
        "key": "keepLocalAudio",
        "type": "boolean",
        "label": "Keep audio on this computer",
        "defaultValue": false
      }
    ]
  }
}

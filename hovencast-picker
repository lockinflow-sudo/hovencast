#!/bin/bash

set -u

ipc_target="${HOVENCAST_IPC_TARGET:-hoven.cast}"
allow_token=""
for argument in "$@"; do
  if [[ "$argument" == "--allow-token" ]]; then
    allow_token="r"
  fi
done

if [[ -z "${XDG_RUNTIME_DIR:-}" ]]; then
  echo "HovenCast picker requires XDG_RUNTIME_DIR" >&2
  exit 1
fi

runtime_root="$XDG_RUNTIME_DIR/hovencast-picker"
mkdir -p -m 700 "$runtime_root"
chmod 700 "$runtime_root"
selection_file="$runtime_root/source-selection"
auto_selection_file="$runtime_root/auto-selection.json"
ipc_target_file="$runtime_root/ipc-target.json"
rm -f "$selection_file"
selection_committed=0

if [[ -f "$ipc_target_file" ]]; then
  ipc_request="$(cat -- "$ipc_target_file" 2>/dev/null || true)"
  rm -f -- "$ipc_target_file"
  ipc_pid="$(jq -r '.pid // 0' <<<"$ipc_request" 2>/dev/null || printf '0')"
  requested_target="$(jq -r '.target // empty' <<<"$ipc_request" 2>/dev/null || true)"
  if [[ "$ipc_pid" =~ ^[0-9]+$ ]] && kill -0 "$ipc_pid" 2>/dev/null \
    && [[ "$requested_target" =~ ^[A-Za-z0-9_.-]+$ ]]; then
    ipc_target="$requested_target"
  fi
fi

if [[ -f "$auto_selection_file" ]]; then
  auto_selection="$(cat -- "$auto_selection_file" 2>/dev/null || true)"
  rm -f -- "$auto_selection_file"
  auto_pid="$(jq -r '.pid // 0' <<<"$auto_selection" 2>/dev/null || printf '0')"
  auto_output="$(jq -r '.output // empty' <<<"$auto_selection" 2>/dev/null || true)"
  auto_source="$(jq -r '.selection // empty' <<<"$auto_selection" 2>/dev/null || true)"
  auto_metadata="$(jq -c '.metadata // {}' <<<"$auto_selection" 2>/dev/null || true)"
  [[ -n "$auto_source" ]] || auto_source="screen:$auto_output"
  source_valid=0
  if [[ "$auto_source" == "screen:$auto_output" ]]; then
    source_valid=1
  elif [[ "$auto_source" =~ ^region:${auto_output}@-?[0-9]+,-?[0-9]+,[0-9]+,[0-9]+$ ]]; then
    source_valid=1
  fi
  if [[ "$auto_pid" =~ ^[0-9]+$ ]] && kill -0 "$auto_pid" 2>/dev/null \
    && [[ -n "$auto_output" ]] \
    && (( source_valid )) \
    && hyprctl -j monitors all 2>/dev/null | jq -e --arg output "$auto_output" \
      '.[] | select(.name == $output)' >/dev/null; then
    printf '%s\n' "$auto_metadata" >"$selection_file.tmp"
    mv -f "$selection_file.tmp" "$selection_file"
    selection_committed=1
    printf '[SELECTION]%s/%s\n' "$allow_token" "$auto_source"
    exit 0
  fi
fi

monitor_json="$(hyprctl -j monitors 2>/dev/null | jq -c '([.[] | select(.focused)] + .)[0] // {}' 2>/dev/null)"
output="$(jq -r '.name // empty' <<<"$monitor_json")"
description="$(jq -r '.description // empty' <<<"$monitor_json")"
width="$(jq -r '.width // 0' <<<"$monitor_json")"
height="$(jq -r '.height // 0' <<<"$monitor_json")"

if [[ -z "$output" ]]; then
  exit 1
fi

preview="$runtime_root/${output//[^A-Za-z0-9_.-]/_}.png"
grim -o "$output" -s 0.25 "$preview" >/dev/null 2>&1 || preview=""
window_list_b64="$(printf '%s' "${XDPH_WINDOW_SHARING_LIST:-}" | base64 -w0)"

cleanup() {
  omarchy-shell "$ipc_target" pickerClose >/dev/null 2>&1 || true
  rm -f -- "$preview" "$selection_file.tmp"
  if (( ! selection_committed )); then
    rm -f -- "$selection_file"
  fi
}
trap cleanup EXIT INT TERM

if ! omarchy-shell "$ipc_target" pickerOpen \
  "$output" "$description" "$width" "$height" "$preview" "$window_list_b64" >/dev/null; then
  exit 1
fi

for ((attempt = 0; attempt < 3000; attempt++)); do
  result="$(omarchy-shell "$ipc_target" pickerResult 2>/dev/null || true)"
  case "$result" in
    screen:*|window:*|region:*)
      metadata="$(omarchy-shell "$ipc_target" pickerMetadata 2>/dev/null || true)"
      printf '%s\n' "$metadata" >"$selection_file.tmp"
      mv -f "$selection_file.tmp" "$selection_file"
      selection_committed=1
      if [[ "$result" == window:* ]]; then
        # Use the stable monitor portal stream. HovenCast crops it to the chosen
        # window and follows that window as its geometry changes.
        printf '[SELECTION]%s/screen:%s\n' "$allow_token" "$output"
      else
        printf '[SELECTION]%s/%s\n' "$allow_token" "$result"
      fi
      exit 0
      ;;
    area)
      region="$(slurp -f '%o@%x,%y,%w,%h' 2>/dev/null || true)"
      if [[ -n "$region" ]]; then
        metadata="$(omarchy-shell "$ipc_target" pickerMetadata 2>/dev/null || true)"
        printf '%s\n' "$metadata" >"$selection_file.tmp"
        mv -f "$selection_file.tmp" "$selection_file"
        selection_committed=1
        printf '[SELECTION]%s/region:%s\n' "$allow_token" "$region"
        exit 0
      fi
      exit 1
      ;;
    cancel)
      exit 1
      ;;
  esac
  sleep 0.1
done

exit 1

#!/bin/bash

set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
packages=(
  avahi
  ffmpeg
  gcc
  grim
  gst-plugin-pipewire
  gst-plugins-bad
  gst-plugins-base-libs
  gst-plugins-good
  gst-plugins-ugly
  gst-rtsp-server
  gstreamer
  jq
  libportal
  libpulse
  pkgconf
  python
  python-gobject
  slurp
  xdg-desktop-portal-hyprland
)
missing=()

for package in "${packages[@]}"; do
  pacman -Q "$package" >/dev/null 2>&1 || missing+=("$package")
done

if (( ${#missing[@]} > 0 )); then
  echo "Installing required Arch packages: ${missing[*]}"
  omarchy pkg add "${missing[@]}"
fi

for element in pipewiresrc videoconvert videoscale videorate x264enc h264parse \
  pulsesrc audioconvert audioresample fdkaacenc aacparse mpegtsmux; do
  gst-inspect-1.0 "$element" >/dev/null 2>&1 || {
    echo "Required GStreamer element is unavailable: $element" >&2
    exit 1
  }
done

python -c 'import gi; gi.require_version("Gst", "1.0"); gi.require_version("Xdp", "1.0"); from gi.repository import Gst, Xdp'
"$root/build-backend"
python "$root/scripts/portal_config.py" install --picker "$root/omarchy-cast-picker"
systemctl --user restart xdg-desktop-portal-hyprland.service xdg-desktop-portal.service

echo "HovenCast setup complete. The backend was built locally and the portal picker is active."

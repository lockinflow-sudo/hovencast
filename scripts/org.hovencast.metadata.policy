<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>HovenCast</vendor>
  <action id="org.hovencast.metadata.read">
    <description>Read selected HovenCast receiver advertisements</description>
    <message>Authorization is required to read selected receiver advertisements</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>no</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/hovencast-metadata-reader</annotate>
  </action>
</policyconfig>

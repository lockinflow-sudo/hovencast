<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>HovenCast</vendor>
  <action id="org.hovencast.p2p.connect">
    <description>Connect HovenCast to a Wi-Fi Direct display</description>
    <message>Authorization is required to connect a HovenCast display</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>no</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/hovencast-p2p-helper</annotate>
  </action>
</policyconfig>
